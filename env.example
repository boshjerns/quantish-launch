# ===========================================
# SOLANA MULTI-WALLET SNIPER CONFIGURATION
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ===========================================
# NETWORK CONFIGURATION
# ===========================================
# Use 'mainnet-beta' for real trading, 'devnet' for testing
SOLANA_NETWORK=devnet

# Custom RPC endpoint (recommended for faster transactions)
# Free options: https://api.mainnet-beta.solana.com
# Paid options: Helius, QuickNode, Triton, etc.
SOLANA_RPC_URL=https://api.devnet.solana.com

# WebSocket endpoint for real-time updates (optional)
SOLANA_WS_URL=wss://api.devnet.solana.com

# ===========================================
# MASTER WALLET (FUNDING SOURCE)
# ===========================================
# Your master wallet private key (Base58 encoded)
# This wallet will fund all sub-wallets
# KEEP THIS EXTREMELY SECURE!
MASTER_WALLET_PRIVATE_KEY=

# ===========================================
# WALLET ENCRYPTION
# ===========================================
# Encryption password for stored wallet keys
# Use a strong, unique password
WALLET_ENCRYPTION_PASSWORD=

# ===========================================
# TRADING CONFIGURATION
# ===========================================
# Default slippage tolerance (in basis points, 100 = 1%)
DEFAULT_SLIPPAGE_BPS=500

# Priority fee in microlamports (higher = faster confirmation)
PRIORITY_FEE_MICROLAMPORTS=100000

# Maximum retries for failed transactions
MAX_TX_RETRIES=3

# Transaction timeout in milliseconds
TX_TIMEOUT_MS=60000

# ===========================================
# SNIPER CONFIGURATION
# ===========================================
# Enable/disable auto-buy on token detection
AUTO_BUY_ENABLED=false

# Minimum SOL amount per wallet for buys
MIN_BUY_AMOUNT_SOL=0.01

# Maximum SOL amount per wallet for buys
MAX_BUY_AMOUNT_SOL=0.1

# ===========================================
# API KEYS (OPTIONAL - for enhanced features)
# ===========================================
# Helius API key for enhanced RPC
HELIUS_API_KEY=

# Jupiter API (usually no key needed)
JUPITER_API_URL=https://quote-api.jup.ag/v6


