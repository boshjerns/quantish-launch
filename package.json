{
  "name": "solana-sniper",
  "version": "1.0.0",
  "description": "Solana token sniper with multi-wallet support",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "generate-wallets": "npx tsx src/cli/generate-wallets.ts",
    "distribute": "npx tsx src/cli/distribute.ts",
    "auto-distribute": "npx tsx src/cli/auto-distribute.ts",
    "snipe": "npx tsx src/cli/snipe.ts",
    "snipe-v2": "npx tsx src/cli/snipe-v2.ts",
    "status": "npx tsx src/cli/status.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.98.0",
    "@types/bn.js": "^5.2.0",
    "bn.js": "^5.2.2",
    "bs58": "^6.0.0",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.4.5",
    "pump-anchor-idl": "^1.0.1"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

